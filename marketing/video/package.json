{
  "name": "swingbyy-video",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion video engine for SwingByy marketing reels. Vertical 9:16 primary.",
  "scripts": {
    "studio": "remotion studio",
    "render:reel": "remotion render reel-9x16 out/reel-9x16.mp4 --concurrency=50%",
    "render:square": "remotion render square-1x1 out/square-1x1.mp4 --concurrency=50%",
    "render:wide": "remotion render wide-16x9 out/wide-16x9.mp4 --concurrency=50%",
    "collect": "node scripts/collect-screens.mjs",
    "catalog": "node scripts/catalog.mjs",
    "lint:claims": "python ../../tools/claim_lint.py marketing/video"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
