# backend/.env.example — every environment variable the backend reads.
#
# SB-0027: this file did not exist. The only backend env documentation was a
# six-line block in docs/RUNNING_LOCALLY.md that named a variable the code never
# reads and omitted thirty it does. Copy to `backend/.env` and fill in.
#
# NEVER commit a filled-in .env. `.env*` is gitignored (including
# .env.production / .env.staging / .env.preview, added in the same pass —
# SB-0026), and this file is the one deliberate exception.
#
# Production values live in the Render dashboard; backend/render.yaml declares
# the NAMES with `sync: false` so the deploy manifest documents the surface
# without holding a single secret.

# ── Required: the backend will not start without these ──────────────────────
SECRET_KEY=                       # JWT signing secret; generate with `openssl rand -hex 32`
SUPABASE_URL=https://ulnxapnsenzyddddldjt.supabase.co

# One of these two. Newer Supabase projects issue SUPABASE_SECRET_KEY; older
# ones SUPABASE_SERVICE_KEY. This is the service_role key — it BYPASSES RLS and
# is backend-only. It must never reach a client.
SUPABASE_SERVICE_KEY=
SUPABASE_SECRET_KEY=

# The PUBLIC key, used only for session-creating auth calls (signup, login,
# refresh, OAuth exchange). Required: supabase_client REFUSES to fall back to
# the service-role key for these (SB-0024), so leaving both blank now fails
# loudly at import rather than silently sending the admin key on every login.
SUPABASE_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ── Environment ─────────────────────────────────────────────────────────────
ENV=development                   # "production" on Render. Gates /docs, CORS localhost defaults, /health detail.
LOG_LEVEL=INFO
LOG_FORMAT=console                # "json" in production
# Trusted X-Forwarded-For hops (SB-0011/SB-0017). Defaults to 1 in production,
# 0 elsewhere. Counting too FEW reads attacker-controlled text; too MANY
# collapses every caller onto one rate-limit bucket.
TRUSTED_PROXY_HOPS=

# Only needed for raw SQL / migrations. Absent is normal and healthy.
DATABASE_URL=

# Comma-separated extra CORS origins. A wildcard is dropped, loudly.
SWINGBY_ALLOWED_ORIGINS=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                # sk_test_... locally
STRIPE_PUBLISHABLE_KEY=           # pk_test_... — the native Payment Sheet needs this one
STRIPE_WEBHOOK_SECRET=            # whsec_...
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=
STRIPE_MERCHANT_IDENTIFIER=       # Apple Pay merchant id
STRIPE_KEY_STRICT=                # "1" makes a malformed key fail at startup instead of at first charge
PAYMENT_REQUIRE_CAPTURE=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_INBOX_EMAIL=

# ── Captcha ─────────────────────────────────────────────────────────────────
# Two switches (SB-0046). The secret enables VERIFICATION of tokens that are
# sent; HCAPTCHA_ENFORCE=1 is what starts REFUSING signups with no token. No
# client sends one yet, so enforcing today refuses 100% of signups.
HCAPTCHA_SECRET=
HCAPTCHA_SITEKEY=
HCAPTCHA_ENFORCE=

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=
# Gates /health's environment name and key-shape detail behind a token.
HEALTH_DIAGNOSTICS_TOKEN=

# ── Google ──────────────────────────────────────────────────────────────────
# NOTE: the key that was in git history is compromised and must be rotated
# before use — see SB-0023 in docs/bugs/LEDGER.md.
GOOGLE_MAPS_API_KEY=
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=
GOOGLE_BUSINESS_REDIRECT_PREFIXES=
GOOGLE_REVIEWS_ENABLED=

# ── Auth redirects ──────────────────────────────────────────────────────────
# A SCHEME-ONLY value ("exp://") is refused in production: it matches every host
# under that scheme and reopens pentest M-01 (SB-0020). Use the full prefix,
# e.g. exp://10.0.0.168:8081/--/
SOCIAL_AUTH_REDIRECT_PREFIXES=
PASSWORD_RESET_REDIRECT_URL=
BASE_URL=

# ── Optional / integrations ─────────────────────────────────────────────────
NOTION_TOKEN=                     # best-effort CRM sync; unset disables it
SEARCH_EMBEDDING_API_KEY=
SEARCH_EMBEDDING_MODEL=
API_ENABLE_DOCS=                  # "1" re-opens /docs in production
MAX_REQUEST_BYTES=                # global request-body ceiling, default 12 MB

# ── Local scripts only (never set on Render) ────────────────────────────────
DEMO_SEED_PASSWORD=
SMOKE_TIMEOUT=
RENDER_URL=                       # target for `pytest -m smoke`
SWINGBY_ENV_FILE=
