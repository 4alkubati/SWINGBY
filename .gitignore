# Python
__pycache__/
*.pyc
*.pyo
*.pyd
# No trailing slash: a bare `.venv/` matches directories only, which is how a
# broken self-referential `backend/.venv` symlink got committed (removed
# 2026-08-04). Without the slash this covers the symlink case too.
.venv
.env
# Social publishing credentials (tools/social_post.py reads this).
.env.social
*.sqlite3
*.db

# Node
node_modules/
dist/

# Expo / React Native
.expo/
.expo-shared/

# Claude Code worktrees (transient agent workspaces — never commit)
.claude/worktrees/

# OS
.DS_Store
Thumbs.db
CODE/
research/
push.log

# Local scratch — one-off dumps that should never be committed.
tree.txt
Untitled.base
Untitled.md
Untitled*.md

# Obsidian — personal vault config, never commit
.obsidian/

# Local-only credentials vault (test accounts + API keys + service notes).
# Only the README is committed so the folder structure is discoverable.
credentials/*
!credentials/README.md

# Legacy test-credential patterns (kept so any stragglers stay ignored)
SEED ACCOUNT FOR TESTING*
SEED ACCOUNT*
seed-account*
test-credentials*

# Live credentials for autonomous agents — NEVER commit
# Templates (*.template.txt) are committed; filled-in files are not.
.claude/secrets/*
!.claude/secrets/*.template.txt
!.claude/secrets/.gitkeep
!.claude/secrets/README.md

# Personal operator profile — keep local, never push
AGENTS/claude/KIRA.md

# Transient orchestrator artifacts — never commit
AGENTS/claude/.scratch/
AGENTS/claude/automation/overnight.log
AGENTS/claude/automation/.overnight.lock
AGENTS/claude/automation/RESUME
AGENTS/claude/automation/*.log
AGENTS/claude/memory/DOCTOR-LATEST.md
AGENTS

# Agent-skill installs (`npx skills add ...`) — machine-local tooling, not app
# code. Reproducible on any box; committing them just creates dirty-tree noise
# that the SwingBy doctor reports as a real problem every session.
backend/.agents/
backend/.claude/
backend/skills-lock.json

# ── Cloudflare Wrangler local state ──────────────────────────────────────────
# Cache files carrying the Cloudflare account ID and the account-name email.
# Four of these were tracked before this rule existed; they are untracked in the
# same commit that adds it. This repo is PUBLIC — none of it should be readable.
.wrangler/
**/.wrangler/

# ── Env variants beyond the bare `.env` rule above ───────────────────────────
# `.env` alone does not match these, and a `.env.local` with real values is the
# easiest possible accident.
.env.local
.env.*.local
.env.development
.env.test

# ── Signing material — NEVER commit ──────────────────────────────────────────
# Preventive, and deliberately added BEFORE it is needed: the Apple Developer
# account is paid and TestFlight is next, so an App Store Connect .p8 and an
# Android keystore are about to land on this disk. GitHub push protection does
# not reliably catch raw private keys, so the ignore rule is the real guard.
*.p8
*.p12
*.pem
*.key
*.keystore
*.jks
*.mobileprovision
*.cer
service-account*.json
google-services.json
GoogleService-Info.plist

# ── Tool caches ──────────────────────────────────────────────────────────────
# These were only ignored by self-written nested .gitignore files — fragile.
.pytest_cache/
.ruff_cache/

# graphify knowledge graph — 27MB build artifact, regenerate with `graphify update .`
graphify-out/
