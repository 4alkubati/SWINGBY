# Backend API base URL
VITE_API_URL=http://localhost:8000

# Supabase (anon/publishable key only — service role key NEVER goes here)
VITE_SUPABASE_URL=https://ulnxapnsenzyddddldjt.supabase.co
VITE_SUPABASE_ANON_KEY=

# Sentry (optional — leave empty to disable)
VITE_SENTRY_DSN=

# Analytics — Plausible (optional)
VITE_PLAUSIBLE_DOMAIN=swingbyy.com

# hCaptcha site key (optional — leave empty during development)
VITE_HCAPTCHA_SITEKEY=

# Maintenance mode: set to "true" to show maintenance page
VITE_MAINTENANCE_MODE=false

# PostHog. Leave unset and no analytics script is loaded at all.
# The project key is public by design (it only writes events).
# For an EU project set the host to https://eu.i.posthog.com AND swap the
# us-* hosts for eu-* in public/_headers, or the CSP blocks it silently.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
