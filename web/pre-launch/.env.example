VITE_API_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PostHog. Leave unset and no analytics script is loaded at all.
# The project key is public by design (it only writes events).
# For an EU project set the host to https://eu.i.posthog.com AND swap the
# us-* hosts for eu-* in public/_headers, or the CSP blocks it silently.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# SB-0030 — read by the app but previously undocumented here.
# Sentry DSN for the browser SDK. Unset disables error reporting.
VITE_SENTRY_DSN=
# Pre-launch gate. "true" (or unset) serves the waitlist only; set to false at
# launch to bring the full site back. Nothing is deleted either way.
VITE_PRELAUNCH_GATE=true
